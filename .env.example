# Postgres. Producao: Neon (ex.: postgres://user:pass@ep-xxx.neon.tech/afroretratos?sslmode=require)
DATABASE_URL=postgres://afro:afro@localhost:5437/afroretratos

# Redis. Producao: Upstash TCP (ex.: rediss://default:xxx@xxx.upstash.io:6379)
REDIS_URL=redis://localhost:6377

# Segredo do HMAC que gera o ip_hash. Obrigatorio em producao.
ORIGIN_HASH_SECRET=

# Chave AES-256-GCM (32 bytes em base64) para guardar o IP criptografado. Opcional.
ORIGIN_ENCRYPTION_KEY=

# Numero de proxies confiaveis a direita do X-Forwarded-For (Vercel = 1, sem proxy = 0).
TRUSTED_PROXY_HOPS=0

# Cloudflare na frente da origem? (cf-connecting-ip so e aceito quando true)
TRUST_CLOUDFLARE_HEADER=false

# Rate limit (por origem)
RATE_LIMIT_POSTS_PER_MINUTE=5
RATE_LIMIT_POSTS_PER_HOUR=20
RATE_LIMIT_REPORTS_PER_HOUR=10

# Painel de moderacao (minimo 24 caracteres recomendado)
ADMIN_SECRET=troque-por-um-segredo-forte

# URL publica do site (producao: https://seudominio.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
