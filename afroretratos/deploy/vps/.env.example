# Preencha e salve como ~/afroretratos/.env (chmod 600).

# Neon, regiao aws-sa-east-1
# Aplicacao usa a URL com "-pooler"; migrations usam a direta.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxx-pooler.sa-east-1.aws.neon.tech/afroretratos?sslmode=require
DIRECT_DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxx.sa-east-1.aws.neon.tech/afroretratos?sslmode=require

# Upstash, regiao sa-east-1
REDIS_URL=rediss://default:SENHA@xxx.upstash.io:6379

# Segredos da aplicacao (copie do servidor atual para nao invalidar dados)
ORIGIN_HASH_SECRET=
ORIGIN_ENCRYPTION_KEY=
ADMIN_SECRET=

# Alertas no Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SERVER_NAME=Servidor wired.rs
NEXT_PUBLIC_SITE_URL=https://afroretratos.wired.rs
